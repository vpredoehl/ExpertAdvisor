# Owner-only (0600) host/database binding. No credentials are put in argv or logs.
# H4 invokes only the Phase-H Manager/readiness command family.  This explicit
# LOGIN must have exactly the Manager tuple in ADR-0019C; it is never pqxx.
# Authentication remains normal PostgreSQL authentication (for example,
# peer/cert/.pgpass referenced through PGPASSFILE), not a source password.
LSTM_DB_HOST=127.0.0.1
LSTM_DB_NAME=LSTM
CAMPAIGN_OPERATIONS_PRODUCTION_MANAGER_DB_USER=REPLACE_WITH_MANAGER_LOGIN
CAMPAIGN_OPERATIONS_PRODUCTION_DISPATCH_SERVICE_DB_USER=REPLACE_WITH_DISPATCH_SERVICE_LOGIN

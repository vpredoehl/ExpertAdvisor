do $code$
declare
    f record;
    tbl text;
    mv text;
    tf text;
    current_year int := extract(year from current_date)::int;

    pair cursor(yr int) for
        select tablename
        from pg_tables
        where schemaname = 'public'
          and tablename ~ '^[a-z]{6}_[0-9]{4}$'
          and right(tablename, 4) = yr::text
        order by tablename;
begin
    for f in pair(current_year)
    loop
        tbl := f.tablename;
        raise info 'Refreshing fractal MVs for %', tbl;

        foreach tf in array array['15m', '1hr', '4hr', '1day']
        loop
            mv := tbl || '_fractal' || tf;

            if exists (
                select 1
                from pg_matviews
                where schemaname = 'public'
                  and matviewname = mv
            ) then
                begin
                    raise info 'Refreshing %', mv;

                    execute format(
                        'refresh materialized view public.%I',
                        mv
                    );
                exception when others then
                    raise notice '%: % %', mv, SQLERRM, SQLSTATE;
                end;
            else
                raise notice 'Missing materialized view: %', mv;
            end if;
        end loop;

        commit;
    end loop;
end $code$
language 'plpgsql';


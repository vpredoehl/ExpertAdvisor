do $code$
declare
    f record;
    tbl text;
    mv text;
    tf text;
    periods int;
    unit text;
    qs text;
    ind text;
    current_year int := extract(year from current_date)::int;

    pair cursor(yr int) for
        select tablename
        from pg_tables
        where schemaname = 'public'
          and tablename ~ '^[a-z]{6}_[0-9]{4}$'
          and right(tablename, 4) = yr::text
        order by tablename;
begin
    for f in pair(current_year)
    loop
        tbl := f.tablename;
        raise info 'Creating fractal MVs for %', tbl;

        foreach tf in array array['15m', '1hr', '4hr', '1day']
        loop
            case tf
                when '15m' then
                    periods := 15;
                    unit := 'minute';
                when '1hr' then
                    periods := 1;
                    unit := 'hour';
                when '4hr' then
                    periods := 4;
                    unit := 'hour';
                when '1day' then
                    periods := 1;
                    unit := 'day';
            end case;

            mv := tbl || '_fractal' || tf;

            if not exists (
                select 1
                from pg_matviews
                where schemaname = 'public'
                  and matviewname = mv
            ) then
                qs := format(
                    'create materialized view public.%I tablespace view as select * from fractal(%L, %s, %L) with no data',
                    mv,
                    'public.' || tbl,
                    periods,
                    unit
                );

                ind := format(
                    'create index %I on public.%I (ts, fractal_high, fractal_low) tablespace candlestick_index',
                    mv || '_ts_idx',
                    mv
                );

                begin
                    raise info 'Creating %', mv;
                    execute qs;
                    execute ind;
                exception when others then
                    raise notice '%: % %', mv, SQLERRM, SQLSTATE;
                end;
            else
                raise info 'Already exists: %', mv;
            end if;
        end loop;

        commit;
    end loop;
end $code$
language 'plpgsql';


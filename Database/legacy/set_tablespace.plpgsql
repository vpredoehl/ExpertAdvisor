do $code$
declare
	qs1 text;
	f text;
begin
	FOR f in select tablename from pg_tables  where tablename like '%_2026%' order by 1
	LOOP
		qs1 = format('alter table %I set tablespace new;', f);
		BEGIN
			raise info 'executing: %', qs1;
			execute qs1;
		EXCEPTION WHEN OTHERS THEN
			raise info 'skipping';
		END;
		COMMIT;
	END LOOP;
end $code$
language 'plpgsql';

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expertadvisor.local/schemas/semantic-worker-registry-v4.json",
  "title": "ExpertAdvisor Semantic Worker Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "current_layout", "runtimes", "workers"],
  "properties": {
    "schema_version": {"const": 4},
    "current_layout": {"type": "integer", "minimum": 1},
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "directory", "manifest"],
        "properties": {
          "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "directory": {"type": "string"},
          "manifest": {"type": "string"}
        }
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_layout",
          "worker_role",
          "artifact_manifest_schema_version",
          "worker_rule",
          "model_input_width",
          "source_commit",
          "sha256",
          "executable",
          "manifest",
          "runtime_identity",
          "capabilities"
        ],
        "properties": {
          "semantic_layout": {"type": "integer", "minimum": 1},
          "worker_role": {"enum": ["train", "infer"]},
          "artifact_manifest_schema_version": {"enum": [1, 2]},
          "worker_rule": {"enum": ["current", "historical"]},
          "model_input_width": {"type": "integer", "minimum": 1},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "executable": {"type": "string"},
          "manifest": {"type": "string"},
          "runtime_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["train", "infer", "analyze"]}
          }
        }
      }
    }
  }
}
